# /opt/tg-archive/.env  —  chmod 600, root only. Never commit this file.
# ============================================================================
# 1) Local Bot API server credentials — https://my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 2) Dedicated archive bot from @BotFather (NOT the alert bot @cctv_rafnet_bot —
#    one bot can only live on one Bot API server at a time).
TG_BOT_TOKEN=

# 3) OPTIONAL fallback group, used only when a segment matches no route in
#    routes.json. Leave empty to make routes.json the sole authority.
#    Find a chat id with:  /opt/tg-archive/uploader.py --discover-chat
TG_CHAT_ID=

# ---------------------------------------------------------------- runtime knobs
TG_API_BASE=http://127.0.0.1:8092
APP_DB=/var/www/rafnet-cctv/backend/data/cctv.db
STATE_DB=/opt/tg-archive/state.db

# Which camera/area goes to which group. THIS is the coverage control — a camera
# with no matching route is never sent. Re-read live on change, no restart needed.
ROUTES_FILE=/opt/tg-archive/routes.json

# Long-run average egress cap (Mbps), enforced by sleeping BETWEEN files. The transfer itself
# always runs at line rate, so this does NOT soften a burst against live streaming — it only stops
# a backfill from running flat out for hours. Keep it ABOVE the observed per-file rate (measured
# median 43.7 Mbps, peak 60.4 over 103 real uploads) or it fires on every file: at 14 it slept 66%
# of the time for no benefit. 0 disables pacing entirely.
MAX_AVG_MBPS=45

POLL_INTERVAL_SEC=60
BATCH_SIZE=40
MAX_ATTEMPTS=4

# Retry sweep: periodically re-attempt segments that hit a transient terminal failure ('failed' —
# bot removed from a group, long 5xx, etc.). Without it the watermark advances past a failure
# forever and that footage is lost once local retention deletes it. RETRY_INTERVAL_SEC=0 disables.
RETRY_INTERVAL_SEC=900
RETRY_BATCH=20
MAX_FILE_MB=1900
REQUEST_TIMEOUT_SEC=1800
STABILITY_SEC=3

# Stale-salvage filter: skip a segment only when it is BOTH shorter than
# MIN_DURATION_SEC *and* older than STALE_HOURS. After a recording incident the
# recovery pipeline rescues a few seconds out of each corrupt partial and those
# clips arrive hours late, burying the group. Length alone is not a safe test —
# a flaky camera produces legitimately short clips, but they arrive within
# minutes. Set MIN_DURATION_SEC=0 to archive everything regardless.
#
# Keep STALE_HOURS aligned with MAX_LATE_HOURS. A lower value only buys catching a
# salvage flood a few hours sooner, and costs real footage: this rule measures age
# from RECORDING time, so whenever the uploader is running behind — which is exactly
# what happens during the incidents that produce salvage — legitimately short clips
# age past the threshold before they are ever looked at. Observed: a genuine 48s clip
# was dropped at STALE_HOURS=2 purely because the queue was 3h deep.
MIN_DURATION_SEC=120
STALE_HOURS=6

# Ceiling on how late a segment may arrive and still be archived, whatever its
# length. The archive's value is that the group reads in recording order — a clip
# landing hours after it was recorded breaks that permanently. This also doubles as
# the uploader-outage tolerance: set it above the longest downtime you would still
# want backfilled. 0 disables.
#
# 12, not 6. Raised after 2026-07-28: the recovery queue jammed on 1693 unrecoverable
# partials and finalization fell 2h behind and was still losing ground — real 10-minute
# segments would have aged past a 6h threshold and been discarded. The failure this
# guard exists to prevent (a salvage flood arriving out of order) and the failure a
# tight threshold causes (discarding real footage) show up in the SAME incident, so the
# threshold has to sit above a plausible stall. Out-of-order arrival is cosmetic;
# throwing away recordings is not.
MAX_LATE_HOURS=12

# Hard cutoff — never archive anything recorded before this instant (ISO-8601).
# Surgical tool for excluding a known-bad window without loosening the rules above.
# Set after the 2026-07-27 crash-loop incident so its salvage never reaches Telegram.
# Empty = no cutoff. A malformed value aborts startup rather than silently doing nothing.
ARCHIVE_MIN_RECORDED_AT=2026-07-27T22:00:00Z

# 1 = upload the entire existing history (204k segments — almost never what you want)
BACKFILL=0
# 1 = log what would be sent, upload nothing
DRY_RUN=0
